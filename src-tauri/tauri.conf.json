{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KetabYar",
  "version": "1.2.0",
  "identifier": "ir.ketabyar.library",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "کتابیار | مدیریت کتابخانه دانشگاه",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://openlibrary.org https://covers.openlibrary.org https://www.googleapis.com https://api.groq.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "KetabYar",
    "copyright": "Copyright © 2026 KetabYar",
    "shortDescription": "کتابیار — مدیریت کتابخانه دانشگاه",
    "longDescription": "KetabYar is an offline, Persian RTL university library management desktop app: catalogue, copies, members, circulation, reservations, fines, inventory and reporting. Built on Tauri + Rust + SQLite.",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "languages": ["English", "Farsi"],
        "displayLanguageSelector": false
      }
    }
  }
}
